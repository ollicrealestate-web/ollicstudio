# Copy to .env and fill in. Never commit .env.

# --- Supabase (Project Settings > API) -------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# The public anon (or publishable) key. Safe for the website; the API also uses it.
SUPABASE_ANON_KEY=
# Only if your project still uses the legacy shared JWT secret (HS256).
# Leave empty for projects on asymmetric JWT signing keys: the API then checks
# tokens against https://<project>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=
# Not used in Phase 1. Background workers will need it from Phase 3; it must
# never be given to the website or to request handlers.
# SUPABASE_SERVICE_ROLE_KEY=

# --- API ---------------------------------------------------------------------
STORAGE_BUCKET=source-files
MAX_UPLOAD_MB=50
# Comma-separated origins allowed to call the API from a browser, if the website
# is served from a different address than the API.
WEB_ORIGINS=http://localhost:5500
# Serve the website from the API in local development (path relative to backend/).
WEB_DIR=../web

# --- Phase 2: concept renders ------------------------------------------------
# Two tiers, offered side by side:
#   Standard render  = Cloudflare Workers AI (free daily allowance), everyone
#   Premium render   = OpenAI (prepaid credit), paid plans only (profiles.plan = 'premium')
# Renders each customer may start per day (UTC midnight). 0 = no limit.
DAILY_RENDERS_PER_USER=3
DAILY_PREMIUM_RENDERS_PER_USER=20
# Cloudflare Workers AI: Account ID from the dashboard address bar; API token from
# My Profile > API Tokens > "Workers AI" template. Server only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# OpenAI, for Premium render (prepaid credit):
# Restricted key: Images = Request, Responses = Write, List models = Read.
# Never put this in the website or in the repository.
OPENAI_API_KEY=
# Optional overrides; defaults checked against OpenAI's docs on 22 Oct 2026.
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# OPENAI_EDIT_MODEL=gpt-image-2.5-sunburst

# Premium prompting: Claude studies the plan, model view, sketches and look references and
# writes the image prompt, and turns plain-words revisions into precise edits. Server only.
# Key from console.anthropic.com (API keys are separate from a claude.ai subscription).
ANTHROPIC_API_KEY=

# Kling (direct, no reseller): cinematic clips, start frame -> end frame AI video. One API key from
# Kling's developer console ("Create a new API Key"); sent as "Authorization: Bearer <key>".
# Paid plans only; about $0.084-0.168 a second. Without it the Cinematic clip button says it is off.
KLING_API_KEY=
# KLING_BASE_URL=https://api-singapore.klingai.com   # Kling's endpoint for servers outside China
# KLING_MODEL=kling-3.0
# DAILY_CLIPS_PER_USER=5

# Google Gemini API (direct): Nano Banana 2.1 for the animation's clean line drawings ($0.034-0.05 each).
# Key from Google AI Studio with billing on. Without it the line drawings use the render models.
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Ollic VS (fal.ai): one key for an image option (Flux Kontext Pro) and a video option (Seedance 2.0).
# fal.ai -> Dashboard -> API Keys. Customers only ever see "Ollic VS".
FAL_KEY=
# Ollic Path and Path Plus (Runway API, direct): AI walkthroughs. The model's exact guide video along a
# camera path becomes a photoreal shot (Aleph 2 about $0.28/s; Kling O3 about $0.17/s). dev.runwayml.com ->
# your organisation -> API keys; buy credits there ($0.01 each). Without it the walkthrough option is off.
RUNWAY_API_KEY=
# Revit (.rvt) files: Autodesk Platform Services converts them to IFC (Model Derivative, Flex tokens).
# aps.autodesk.com -> My Apps -> create an app with Data Management and Model Derivative APIs.
# Without them, customers are told to export IFC from Revit.
APS_CLIENT_ID=
APS_CLIENT_SECRET=
# Largest IFC the server reads itself, in MB (the browser reads bigger ones). 12 suits a 512 MB server.
# IFC_MAX_MB=12
# PREMIUM_PROMPT_MODEL=claude-opus-5-5   (claude-fable-5-1 for the very top, at about 2.5x the cost)
# OPENAI_BASE_URL=https://api.openai.com/v1
RENDERS_BUCKET=renders

# --- Live isolation check (scripts/verify_isolation.py) ---------------------
API_URL=http://localhost:8000
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
